// Behaviour pinned for the Vulkan declaration set. The FFI surface itself cannot be exercised
// without a Vulkan driver, which no CI runner has, but the `vk::` VkResult accessors are plain
// space functions and their values are exactly what callers branch on, so they are pinned here.
//
// Reference values are the Khronos headers (include/vulkan/vulkan_core.h, VK_HEADER_VERSION 365):
//   VK_SUCCESS = 0, VK_NOT_READY = 1, VK_INCOMPLETE = 5,
//   VK_ERROR_OUT_OF_DATE_KHR = -1000001004, VK_ERROR_INCOMPATIBLE_DRIVER = -9.
//
// Corrected here: ERROR_INCOMPATIBLE_DRIVER used to return -1000001001, which is not a Khronos
// value, and now returns -9. ERROR_NOT_READY used to return -1000001005, but vulkan_core.h has
// no VK_ERROR_NOT_READY at all: the real code is VK_NOT_READY = 1, a success code, exposed as
// vk::NOT_READY().
import "vulkan";

program main;

fn chk(IOStream io, List<int> st, String name, bool cond) int {
    if (cond) {
        io.println("OK " + name);
    } else {
        st[0] = st[0] + 1;
        io.println("FAIL " + name);
    }
    return 0;
}

fn chkI(IOStream io, List<int> st, String name, int got, int want) int {
    if (got == want) {
        io.println("OK " + name);
    } else {
        st[0] = st[0] + 1;
        io.println("FAIL " + name + " got=" + got.toString() + " want=" + want.toString());
    }
    return 0;
}

fn main(IOStream io) {
    List<int> st = [0];

    // Exact values from the Khronos header.
    chkI(io, st, "success-is-zero", vk::SUCCESS(), 0);
    chkI(io, st, "not-ready-is-one", vk::NOT_READY(), 1);
    chkI(io, st, "incomplete-is-five", vk::INCOMPLETE(), 5);
    chkI(io, st, "error-out-of-date-khr", vk::ERROR_OUT_OF_DATE_KHR(), -1000001004);
    chkI(io, st, "error-incompatible-driver", vk::ERROR_INCOMPATIBLE_DRIVER(), -9);

    // vulkan.qk documents the contract as "common VkResult predicates (>= 0 means success)". The
    // sign test is that contract. VK_NOT_READY is a success code, so it must be non-negative like
    // VK_SUCCESS and VK_INCOMPLETE; only the VK_ERROR_* values are negative.
    chk(io, st, "success-is-a-success-code", vk::SUCCESS() >= 0);
    chk(io, st, "not-ready-is-a-success-code", vk::NOT_READY() >= 0);
    chk(io, st, "incomplete-is-a-success-code", vk::INCOMPLETE() >= 0);
    chk(io, st, "error-out-of-date-khr-is-negative", vk::ERROR_OUT_OF_DATE_KHR() < 0);
    chk(io, st, "error-incompatible-driver-is-negative", vk::ERROR_INCOMPATIBLE_DRIVER() < 0);

    io.println("failures=" + st[0].toString());
}
