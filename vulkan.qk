/* QuarkLang 官方库：vulkan —— Vulkan 图形 API 绑定（官方认证）
 *
 * library vulkan { ... } 声明集：直接调用系统 Vulkan 导出符号（跨系统：
 * Linux: libvulkan.so.1；macOS: libvulkan.dylib；Windows: vulkan-1.dll）。
 * 运行时跨系统加载（dlopen/LoadLibrary）经 libffi 调用。
 *
 * 类型映射：int=uint32_t/VkResult；f32=float；String=const char*；
 * 指针参数（VkInstance/VkDevice 等句柄）v1 以 String 十六进制句柄传递。
 */
program library;

library vulkan {
    // ---- 实例（前六层） ----
    fn vkCreateInstance(String pCreateInfo, String pAllocator, String pInstance) int;
    fn vkDestroyInstance(String instance, String pAllocator) void;
    fn vkEnumerateInstanceExtensionProperties(String pLayerName, String pCount, String pProperties) int;
    fn vkEnumerateInstanceLayerProperties(String pCount, String pProperties) int;

    // ---- 物理设备枚举 ----
    fn vkEnumeratePhysicalDevices(String instance, String pCount, String pDevices) int;
    fn vkGetPhysicalDeviceProperties(String device, String pProperties) void;
    fn vkGetPhysicalDeviceFeatures(String device, String pFeatures) void;
    fn vkGetPhysicalDeviceQueueFamilyProperties(String device, String pCount, String pProperties) void;
    fn vkEnumerateDeviceExtensionProperties(String device, String pLayerName, String pCount, String pProperties) int;

    // ---- 逻辑设备/队列 ----
    fn vkCreateDevice(String physicalDevice, String pCreateInfo, String pAllocator, String pDevice) int;
    fn vkDestroyDevice(String device, String pAllocator) void;
    fn vkGetDeviceQueue(String device, int queueFamily, int queueIndex, String pQueue) void;
    fn vkDeviceWaitIdle(String device) int;

    // ---- 交换链/渲染 ----
    fn vkCreateSwapchainKHR(String device, String pCreateInfo, String pAllocator, String pSwapchain) int;
    fn vkAcquireNextImageKHR(String device, String swapchain, long timeout, String semaphore, String fence, String pImageIndex) int;
    fn vkQueuePresentKHR(String queue, String pPresentInfo) int;
    fn vkQueueSubmit(String queue, int submitCount, String pSubmits, String fence) int;

    // ---- 内存/缓冲 ----
    fn vkAllocateMemory(String device, String pAllocateInfo, String pAllocator, String pMemory) int;
    fn vkFreeMemory(String device, String memory, String pAllocator) void;
    fn vkMapMemory(String device, String memory, long offset, long size, int flags, String ppData) int;
    fn vkCreateBuffer(String device, String pCreateInfo, String pAllocator, String pBuffer) int;
    fn vkCreateImageView(String device, String pCreateInfo, String pAllocator, String pImageView) int;

    // ---- 查询 ----
    fn vkGetInstanceProcAddr(String instance, String pName) long;
}

space {
    // 常用 VkResult 判定（>=0 为成功）
    fn SUCCESS() int { return 0; }
    fn INCOMPLETE() int { return 5; }
    fn ERROR_OUT_OF_DATE_KHR() int { return -1000001004; }
    fn ERROR_INCOMPATIBLE_DRIVER() int { return -1000001001; }
    fn ERROR_NOT_READY() int { return -1000001005; }
} vk;
